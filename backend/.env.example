# Variables de entorno del backend de Andesbus
# Copia este archivo a ".env" y completa los valores.

# Puerto donde corre la API + el frontend estatico (desarrollo local)
PORT=3001

# Base de datos PostgreSQL (Supabase).
# Opción 1: cadena de conexión completa (la que te da Supabase -> Settings -> Database).
#   Usa el pooler de producción si vas a desplegar en Vercel:
#   postgresql://postgres.<proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:clave@localhost:5432/andesbus

# Opción 2 (alternativa a DATABASE_URL): conexión por partes
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
# DATABASE_NAME=andesbus

# En producción (Supabase/Vercel) la conexión exige SSL
PGSSL=true

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Nombre de la cookie de sesion
COOKIE_NAME=andesbus_token

# Tiempo (en minutos) de validez del token de recuperacion de contrasena
RESET_TOKEN_MINUTOS=30

# En desarrollo, la URL de recuperacion se muestra en el log (no hay servidor de correo)
APP_BASE_URL=http://localhost:3001
