# Variables de entorno del backend de Andesbus
# Copia este archivo a ".env" y completa los valores.

# Puerto donde corre la API + el frontend estatico
PORT=3001

# Base de datos MySQL (compatible con MariaDB de XAMPP)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=andesbus

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Nombre de la cookie de sesion
COOKIE_NAME=andesbus_token

# Tiempo (en minutos) de validez del token de recuperacion de contrasena
RESET_TOKEN_MINUTOS=30

# En desarrollo, la URL de recuperacion se muestra en el log (no hay servidor de correo)
APP_BASE_URL=http://localhost:3001
